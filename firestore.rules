rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Reads are public: pages read players, matches and eloHistory with the
    // client SDK and there is no sign-in.
    //
    // Client writes are denied. Every mutation goes through the API routes
    // (app/api/*), which use the Admin SDK — that bypasses these rules and
    // keeps Elo math and the player/match/eloHistory transaction server-side.
    // Maintenance scripts in scripts/ also use the Admin SDK.

    match /players/{playerId} {
      allow read: if true;
      allow write: if false;
    }

    match /matches/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    match /eloHistory/{historyId} {
      allow read: if true;
      allow write: if false;
    }

    // Anything else (unknown collections) is denied by default.
  }
}
